class Solution(object):
    def findKthSmallest(self, coins, k):
        """
        :type coins: List[int]
        :type k: int
        :rtype: int
        """
        coins = list(set(coins))
        arr = []
        for c in sorted(coins):
            useful = True
            for x in arr:
                if c % x == 0:
                    useful = False
                    break
            if useful:
                arr.append(c)
        coins = arr
        def gcd(a, b):
            while b:
                a, b = b, a % b
            return a
        def lcm(a, b):
            return (a // gcd(a, b)) * b
        def count(x):
            n = len(coins)
            total = 0
            for mask in range(1, 1 << n):
                multiple = 1
                bits = 0
                valid = True
                for i in range(n):
                    if mask & (1 << i):
                        multiple = lcm(multiple, coins[i])
                        bits += 1
                        if multiple > x:
                            valid = False
                            break
                if not valid:
                    continue
                if bits % 2 == 1:
                    total += x // multiple
                else:
                    total -= x // multiple
            return total
        left = 1
        right = min(coins) * k
        while left < right:
            mid = (left + right) // 2
            if count(mid) >= k:
                right = mid
            else:
                left = mid + 1
        return left
