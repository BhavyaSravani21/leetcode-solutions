class Solution(object):
    def stoneGameIX(self, stones):
        """
        :type stones: List[int]
        :rtype: bool
        """
        count = [0, 0, 0]
        for x in stones:
            count[x % 3] += 1
        c0 = count[0]
        c1 = count[1]
        c2 = count[2]
        if c1 == 0 and c2 == 0:
            return False
        if c1 == 0 or c2 == 0:
            return max(c1, c2) > 2 and c0 % 2 == 1
        if c0 % 2 == 0:
            return True
        return abs(c1 - c2) > 2
