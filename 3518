class Solution(object):
    def smallestPalindrome(self, s, k):
        """
        :type s: str
        :type k: int
        :rtype: str
        """
        freq = [0] * 26

        for ch in s:
            freq[ord(ch) - ord('a')] += 1

        half = [0] * 26
        middle = ""

        for i in range(26):
            half[i] = freq[i] // 2
            if freq[i] % 2 == 1:
                middle = chr(i + ord('a'))

        LIMIT = k

        def comb(n, r):
            if r < 0 or r > n:
                return 0
            if r > n - r:
                r = n - r
            ans = 1
            i = 1
            while i <= r:
                ans = ans * (n - r + i) // i
                if ans > LIMIT:
                    return LIMIT
                i += 1
            return ans

        def countWays():
            total = 0
            for x in half:
                total += x

            ans = 1
            rem = total

            for x in half:
                if x > 0:
                    ans *= comb(rem, x)
                    if ans > LIMIT:
                        return LIMIT
                    rem -= x

            return ans

        if countWays() < k:
            return ""

        left = []

        totalHalf = 0
        for x in half:
            totalHalf += x

        while totalHalf > 0:
            for i in range(26):
                if half[i] == 0:
                    continue

                half[i] -= 1
                ways = countWays()

                if ways >= k:
                    left.append(chr(i + ord('a')))
                    totalHalf -= 1
                    break
                else:
                    k -= ways
                    half[i] += 1

        left = "".join(left)
        return left + middle + left[::-1]
