class Solution(object):
    def longestSubsequence(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        n = len(nums)
        xor = 0
        for num in nums:
            xor ^= num
        if xor != 0:
            return n
        for num in nums:
            if num != 0:
                return n - 1
        return 0
