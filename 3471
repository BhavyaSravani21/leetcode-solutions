class Solution(object):
    def largestInteger(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        count = {}
        n = len(nums)
        for i in range(n - k + 1):
            window = set()
            for j in range(i, i + k):
                window.add(nums[j])
            for x in window:
                if x in count:
                    count[x] += 1
                else:
                    count[x] = 1
        ans = -1
        for x in count:
            if count[x] == 1:
                ans = max(ans, x)
        return ans
