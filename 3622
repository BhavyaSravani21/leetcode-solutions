class Solution(object):
    def checkDivisibility(self, n):
        """
        :type n: int
        :rtype: bool
        """
        digit_sum = 0
        digit_product = 1
        x = n
        while x > 0:
            digit = x % 10
            digit_sum += digit
            digit_product *= digit
            x //= 10
        total = digit_sum + digit_product
        return n % total == 0
